+/* Dashed empty-lane dropzone */
+.emptyLane {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--s-4);
+  text-align: center;
+  padding: var(--s-10) var(--s-6);
+  border: 1.5px dashed var(--outline-strong);
+  border-radius: var(--r-lg);
+}
+.emptyLaneIcon {
+  width: 44px;
+  height: 44px;
+  border-radius: var(--r-md);
+  background: var(--well);
+  color: var(--ink-3);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+}
+.emptyLaneTitle {
+  font: var(--t-body-sm);
+  font-weight: 600;
+  color: var(--ink-1);
+  margin: 0;
+}
+.emptyLaneDesc {
+  font: var(--t-caption);
+  color: var(--ink-3);
+  line-height: 1.45;
+  margin: 0;
+  max-width: 28ch;
+}
+.emptyLaneBtn {
+  margin-top: var(--s-2);
+  display: inline-flex;
+  align-items: center;
+  gap: var(--s-3);
+  font: var(--t-label);
+  font-weight: 600;
+  color: var(--ink-inverse);
+  background: var(--primary);
+  border: none;
+  padding: var(--s-4) var(--s-7);
+  border-radius: var(--r-md);
+  cursor: pointer;
+  transition: background var(--dur-fast) var(--easing-standard);
+}
+.emptyLaneBtn:hover {
+  background: var(--primary-hover);
+}
