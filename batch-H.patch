+}
+
+/* ═══ New stats widgets (best time + posting activity) ═══════════ */
+.insightGrid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: var(--s-9);
+}
+.insightCard {
+  background: var(--surface-1);
+  border: 1px solid var(--divider);
+  border-radius: var(--r-lg);
+  box-shadow: var(--shadow-card);
+  padding: var(--s-8) var(--s-9);
+}
+:global(.pp2.dark) .insightCard {
+  border-color: var(--divider-strong);
+}
+
+.insightHead {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  margin-bottom: var(--s-7);
+}
+.insightMeta {
+  font: var(--t-mono);
+  font-size: 11px;
+  color: var(--ink-3);
+}
+
+/* Best time to post */
+.bestTimeValue {
+  font: var(--t-display);
+  font-size: 30px;
+  font-weight: 700;
+  letter-spacing: -0.02em;
+  color: var(--ink-1);
+  margin: 0;
+}
+.bestTimeMeridiem {
+  font-size: 15px;
+  font-weight: 600;
+  color: var(--ink-3);
+  margin-left: 2px;
+}
+.bestTimeSub {
+  font: var(--t-body-sm);
+  color: var(--ink-3);
+  margin: var(--s-3) 0 var(--s-8);
+  line-height: 1.4;
+}
+.bestTimeBars {
+  display: grid;
+  grid-template-columns: repeat(7, 1fr);
+  gap: var(--s-4);
+  align-items: end;
+  height: 92px;
+}
+.bestTimeBarCol {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--s-3);
+  height: 100%;
+  justify-content: flex-end;
+}
+.bestTimeBar {
+  width: 68%;
+  min-height: 6px;
+  border-radius: var(--r-sm) var(--r-sm) 0 0;
+  background: var(--well);
+}
+.bestTimeBarPeak {
+  background: var(--primary);
+}
+.bestTimeDay {
+  font: var(--t-caption);
+  font-size: 10px;
+  color: var(--ink-3);
+}
+
+/* Posting activity heatmap */
+.heatGrid {
+  display: flex;
+  flex-direction: column;
+  gap: var(--s-2);
+}
+.heatRow {
+  display: grid;
+  grid-template-columns: 14px repeat(12, 1fr);
+  gap: var(--s-2);
+  align-items: center;
+}
+.heatRowLabel {
+  font: var(--t-caption);
+  font-size: 10px;
+  color: var(--ink-3);
+  text-align: center;
+}
+.heatCell {
+  aspect-ratio: 1;
+  border-radius: 3px;
+  background: var(--well);
+}
+.heatCell[data-level="1"] {
+  background: var(--heat-1);
+}
+.heatCell[data-level="2"] {
+  background: var(--heat-2);
+}
+.heatCell[data-level="3"] {
+  background: var(--heat-3);
+}
+.heatCell[data-level="4"] {
+  background: var(--heat-4);
+}
+.heatLegend {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: var(--s-2);
+  margin-top: var(--s-6);
+  font: var(--t-caption);
+  font-size: 10px;
+  color: var(--ink-3);
+}
+.heatLegend .heatCell {
+  width: 11px;
+  height: 11px;
+  aspect-ratio: auto;
 }
